@@ -0,0 +1,27 @@
+package connector
+
+import (
+	"github.com/gatework/go-net-connector/internal/terminal"
+	"strings"
+)
+
+// Body renders a single receipt after removing its exact prompt and first-line
+// command echo. It preserves subsequent matching lines and body indentation.
+func (s StepResult) Body() (string, error) {
+	// Prompt regexes consume the preceding line delimiter in Go. Keep that
+	// delimiter as body text, as the Ruby zero-width boundary does.
+	boundary := s.prompt[:len(s.prompt)-len(strings.TrimLeft(s.prompt, "\r\n"))]
+	body, err := terminal.Render([]byte(strings.TrimSuffix(s.output, s.prompt)+boundary), true)
+	if err != nil {
+		return "", err
+	}
+	first, _, _ := strings.Cut(body, "\n")
+	if strings.TrimSpace(first) == strings.TrimSpace(s.command.Text) {
+		if len(body) > len(first) {
+			body = body[len(first)+1:]
+		} else {
+			body = ""
+		}
+	}
+	return body, nil
+}
