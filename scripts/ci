#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export GOWORK=off GOFLAGS=-mod=readonly GOTOOLCHAIN=local
format_files=$(go run golang.org/x/tools/cmd/goimports@v0.52.0 -l .)
if [[ -n "$format_files" ]]; then
  printf 'Go files require formatting:\n%s\n' "$format_files"
  exit 1
fi
python3 scripts/check-delivery.py --modules-only
go version
go mod verify
go mod tidy -diff
go test -race -shuffle=on -count=1 ./...
go vet ./...
python3 scripts/test_check_delivery.py -v
python3 -O scripts/test_check_delivery.py -v
python3 scripts/check-delivery.py
